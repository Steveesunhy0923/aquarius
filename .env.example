# ─────────────────────────────────────────────────────────────────────────────
# Aquarius environment
#
# Aquarius is LOCAL-FIRST. The app runs fully offline with no Supabase keys set —
# all data lives in IndexedDB. Supabase is an OPTIONAL cloud backup / sync target.
# Copy this file to `.env.local` and fill in values only when you want cloud sync.
# ─────────────────────────────────────────────────────────────────────────────

# Public Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.com/dashboard/project/zpwztaitfnulbmscznmt

# Public anon key — safe to expose to the browser (RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_w6Wi8hgIYOJ6ekTu4T3rWw_B4K-Q4bJ

# Optional: Mathpix (OCR / handwriting) — server-side only, do NOT prefix NEXT_PUBLIC
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Optional: Anthropic API for AI features (server-side only)
ANTHROPIC_API_KEY=
