# ─────────────────────────────────────────────────────────────────────────────
# Aquarius environment
#
# Aquarius is LOCAL-FIRST. The app runs fully offline with no Supabase keys set —
# all data lives in IndexedDB. Supabase is an OPTIONAL cloud backup / sync target.
# Copy this file to `.env.local` and fill in values only when you want cloud sync.
# ─────────────────────────────────────────────────────────────────────────────

# Public Supabase project URL — the API URL, NOT the dashboard URL.
# Project Settings → API → "Project URL", e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon/publishable key — safe to expose to the browser (RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: error reporting. Leave empty and nothing is sent anywhere — the
# Sentry SDK is not even downloaded (lib/monitoring.ts). Set it to a Sentry
# project's DSN to receive uncaught errors and failed saves/syncs. Reports
# carry no note content, no request bodies and no user identity.
# Inlined at BUILD time: for the deployed site, set it as the repository
# variable NEXT_PUBLIC_SENTRY_DSN (see .github/workflows/ci.yml).
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Mathpix (OCR / handwriting) — server-side only, do NOT prefix NEXT_PUBLIC
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Optional: Anthropic API for AI features (server-side only)
ANTHROPIC_API_KEY=
