# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (never commit secrets)
.env
.env*.local
.env.local

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/

# supabase local stack
/supabase/.branches
/supabase/.temp
/supabase/.env

# mathlive fonts (generated by prepare-mathlive)
/public/mathlive

# pyodide runtime (generated by prepare-pyodide)
/public/pyodide

# pdf.js runtime (generated by prepare-pdfjs)
/public/pdfjs

# Computer Modern document font (generated by prepare-fonts)
/public/fonts

# ml handwriting->latex pipeline (keep code, ignore env/data/artifacts)
ml/.venv/
ml/data/*
!ml/data/download_mathwriting.py
ml/checkpoints/
ml/export/*.mlpackage
ml/export/*.mlmodel
ml/__pycache__/
ml/**/__pycache__/
/.api-excluded/

# Wrangler's local state (dev caches, local KV/D1). Machine-specific, and it
# can hold values pulled from .env.local — never commit it.
/.wrangler/
