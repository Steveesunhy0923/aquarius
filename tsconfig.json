{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      /*
       * `@atorku/auth` is linked from a sibling checkout (`file:../atorku/...`), and
       * TypeScript resolves a linked package's own imports from its REAL path —
       * so the `SupabaseClient` in its .d.ts came from ~/atorku/node_modules while
       * ours came from ./node_modules. `SupabaseClient` is a class with a
       * protected member, which makes it NOMINALLY typed: two physical copies
       * are two incompatible types even at the identical version, and every
       * call across the boundary fails to typecheck.
       *
       * Pinning the specifier here gives the whole program one declaration.
       * Aquarius imports supabase-js for types only (four files, all `import
       * type`), so at runtime there is a single client instance — the one
       * @atorku/auth constructs — and this mapping makes the types describe
       * exactly that object rather than a second copy of it.
       */
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
